import {
    Theme,
    UISize,
    Images,
    ControlSize,
    ButtonVariant,
} from "@ui/theme.slint";
import { PassphraseState, Word } from "callbacks.slint";
import { Button } from "@ui/button.slint";
import { Dialog, DialogVariant } from "@ui/dialog.slint";
import { SegmentedControl } from "@ui/segmented_control.slint";
import { Switch } from "@ui/switch.slint";

export { PassphraseState, Word, Theme, Images, ControlSize }

// Colours that follow the system theme. Everything is drawn with vector shapes, no images: a raster asset
// is stored as raw pixels on the device and would cost megabytes. Nothing here is a gradient either; the
// software renderer fills flat colour cheaply and gradients at many times the cost per pixel.
global Look {
    out property <color> teal: Theme.palette-primary;
    out property <color> copper: Theme.is-dark ? #d39468 : #b46f45;
    out property <color> edge: Theme.is-dark ? #ffffff1a : #0000001a;
    out property <color> card: Theme.is-dark ? #2b2728e6 : #f4f2f2e6;
}

// How long the screen may sit untouched with a passphrase on it. A touch is a tap on any control.
global Policy {
    // seconds until the words are covered (and Rust stops giving the UI a copy of them)
    out property <int> hide-after: 30;
    // seconds until everything is wiped
    out property <int> wipe-after: 120;
}

// The page behind the content: the background colour in eight flat bands, a little darker towards the
// bottom. Painted once; nothing here ever moves.
component Backdrop inherits Rectangle {
    for band in 8: Rectangle {
        y: band * 100px;
        height: 101px;
        background: Theme.palette-background.mix(Theme.is-dark ? #000000 : #ffffff, band * 0.03);
    }
}

// One numbered word. A new word is shown as coarse blocks that get finer step by step until the real text
// takes over (the "pixel-in"), and leaves the same way backwards. Rows start one after the other.
component WordRow inherits Rectangle {
    in property <int> number;
    in property <string> text;
    in property <[image]> frames;
    in property <bool> revealed;
    in property <bool> leaving;
    in property <length> row-height: 34px;

    height: root.row-height;

    // Where the effect has got to. Below 0 the row is still waiting for its turn, 0 to last-1 show the
    // blocky frames, and `last` is the real text.
    property <int> last: root.frames.length;
    property <int> stage: 1 - root.number;
    property <bool> busy: root.leaving ? root.stage >= 0 : root.stage < root.last;
    property <image> blank;

    // "Show words": 1 = the word, 0 = dots, cross-faded
    property <float> reveal: root.revealed ? 1.0 : 0.0;
    animate reveal {
        duration: 180ms;
        easing: ease-in-out;
    }

    // Steps, not an animation: between the steps the app sleeps, instead of redrawing at the full frame rate.
    Timer {
        interval: root.leaving ? 45ms : 75ms;
        running: root.busy;
        triggered => {
            root.stage += root.leaving ? -1 : 1;
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-xl;
        spacing: Theme.spacing-lg;
        alignment: start;

        Rectangle {
            width: 28px;
            height: 28px;
            y: (root.row-height - 28px) / 2;
            visible: root.stage >= 0;
            border-radius: 14px;
            border-width: 1.5px;
            border-color: Look.copper;
            background: Look.copper.with-alpha(0.12);

            Text {
                text: root.number;
                color: Look.copper;
                font-family: Theme.font-primary;
                font-size: 14px;
                font-weight: Theme.font-weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 300px;

            // the blocky frames: same place as the text, a margin of PIXEL-PAD around it
            Image {
                x: -4px;
                y: (root.row-height - 30px) / 2 - 4px;
                source: root.revealed && root.stage >= 0 && root.stage < root.last ? root.frames[root.stage] : root.blank;
                width: self.source.width * 1px;
                height: self.source.height * 1px;
                colorize: Theme.palette-foreground;
            }

            // the real text, once the effect is done
            Text {
                x: 0px;
                width: parent.width;
                horizontal-alignment: left;
                text: root.text;
                color: Theme.palette-foreground.with-alpha(root.stage >= root.last ? root.reveal : 0.0);
                font-family: Theme.font-primary;
                font-size: Theme.font-size-lg;
                font-weight: Theme.font-weight-semibold;
                vertical-alignment: center;
            }

            Text {
                x: 0px;
                width: parent.width;
                horizontal-alignment: left;
                text: "••••••";
                color: Theme.palette-muted.with-alpha(root.stage >= 0 ? 1.0 - root.reveal : 0.0);
                font-family: Theme.font-primary;
                font-size: Theme.font-size-lg;
                vertical-alignment: center;
            }
        }
    }
}

// One die result slot: shows the digit rolled so far, or an empty box. It lights up when filled.
component Slot inherits Rectangle {
    in property <string> digit;

    property <bool> filled: root.digit != "";

    width: 48px;
    height: 48px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: root.filled ? Look.teal : Look.edge;
    background: root.filled ? Look.teal.with-alpha(0.16) : #00000000;
    animate border-color {
        duration: 180ms;
        easing: ease-out;
    }
    animate background {
        duration: 180ms;
        easing: ease-out;
    }

    Text {
        text: root.digit;
        color: Theme.palette-foreground.with-alpha(root.filled ? 1.0 : 0.0);
        animate color {
            duration: 160ms;
            easing: ease-out;
        }
        font-family: Theme.font-primary;
        font-size: Theme.font-size-title;
        font-weight: Theme.font-weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "Passphrase";
    preferred-width: UISize.screen-width;
    preferred-height: UISize.screen-height;
    background: Theme.palette-background;

    // the words are stepping out before they are replaced
    property <bool> leaving: false;
    // a timer is running that clears / regenerates once the old words are gone
    // (timers are started by switching `running`; restart() does not start them on this platform)
    property <bool> reset-pending: false;
    property <bool> generate-pending: false;
    property <bool> dice: PassphraseState.mode == 1;
    // the word card is taller when there are no dice keys to make room for
    property <length> card-height: root.dice ? 252px : 330px;
    animate card-height {
        duration: 300ms;
        easing: ease-in-out;
    }
    property <length> card-y: 178px;
    property <float> shown-bits: PassphraseState.bits;
    animate shown-bits {
        duration: 500ms;
        easing: ease-out;
    }

    // seconds since the last touch; counted only while there is a passphrase on the screen
    property <int> idle-seconds: 0;

    // A tap that would wipe the passphrase on the screen waits for "Replace" first.
    // 0 = nothing waiting, 1 = Generate new, 2 = Start over, 3 = other mode, 4 = other word count.
    property <int> confirm: 0;
    // The mode and word count the user has accepted. The segmented controls change their own value the
    // moment they are tapped, so a refused change is put back to these.
    property <int> kept-mode: 0;
    property <int> kept-count: 2;
    // What a waiting mode or word-count change would switch to.
    property <int> wanted: 0;

    function touched() {
        root.idle-seconds = 0;
    }

    function replace-words() {
        root.touched();
        root.leaving = true;
        root.reset-pending = true;
    }

    function ask(kind: int) {
        root.touched();
        root.confirm = kind;
    }

    // "Replace" was tapped: do what was waiting.
    function confirmed() {
        root.touched();
        if root.confirm == 1 {
            root.leaving = true;
            root.generate-pending = true;
        } else if root.confirm == 2 {
            root.leaving = true;
            root.reset-pending = true;
        } else if root.confirm == 3 {
            PassphraseState.mode = root.wanted;
            root.kept-mode = root.wanted;
            root.replace-words();
        } else if root.confirm == 4 {
            PassphraseState.count-index = root.wanted;
            root.kept-count = root.wanted;
            root.replace-words();
        }
        root.confirm = 0;
    }

    // Cover the words, and drop a question that was waiting. The idle timeout calls it, and Rust does when the
    // system hides the app.
    public function hide-words() {
        root.confirm = 0;
        PassphraseState.revealed = false;
        PassphraseState.reveal-changed(false);
    }

    // Wipe everything and go back to the empty screen.
    function wipe() {
        root.confirm = 0;
        PassphraseState.restart();
        PassphraseState.revealed = true;
        PassphraseState.reveal-changed(true);
        root.idle-seconds = 0;
    }

    // Rust calls this when the app is shown again after being hidden for `away` seconds. Timers do not run
    // while the app is hidden (the platform's event loop blocks until it is shown again), so that time is
    // counted here, and the wipe that should have happened meanwhile happens now, before anything is shown.
    public function came-back(away: int) {
        root.idle-seconds += away;
        if PassphraseState.words.length > 0 && root.idle-seconds >= Policy.wipe-after {
            root.wipe();
        }
    }

    // Cover the words after Policy.hide-after seconds, wipe everything after Policy.wipe-after.
    // It runs (once a second) only while there are words; the rest of the time the app sleeps.
    idle-timer := Timer {
        interval: 1s;
        running: PassphraseState.words.length > 0;
        triggered => {
            root.idle-seconds += 1;
            if root.idle-seconds == Policy.hide-after && PassphraseState.revealed {
                root.hide-words();
            }
            if root.idle-seconds >= Policy.wipe-after {
                root.wipe();
            }
        }
    }

    // the old words step out first; this fires when they are gone (5 steps of 45 ms)
    reset-timer := Timer {
        interval: 280ms;
        running: root.reset-pending;
        triggered => {
            root.reset-pending = false;
            PassphraseState.restart();
            root.leaving = false;
        }
    }

    generate-timer := Timer {
        interval: 280ms;
        running: root.generate-pending;
        triggered => {
            root.generate-pending = false;
            PassphraseState.generate();
            root.leaving = false;
        }
    }

    Backdrop {
        width: parent.width;
        height: parent.height;
    }

    SegmentedControl {
        x: 24px;
        y: 52px;
        width: 432px;
        height: 56px;
        options: ["Device RNG", "My dice"];
        selected-index <=> PassphraseState.mode;
        changed(index, label) => {
            if PassphraseState.words.length > 0 {
                root.wanted = index;
                PassphraseState.mode = root.kept-mode;
                root.ask(3);
            } else {
                root.kept-mode = index;
                root.replace-words();
            }
        }
    }

    SegmentedControl {
        x: 24px;
        y: 118px;
        width: 432px;
        height: 48px;
        size: ControlSize.sm;
        options: ["4 words", "5 words", "6 words", "8 words"];
        selected-index <=> PassphraseState.count-index;
        changed(index, label) => {
            if PassphraseState.words.length > 0 {
                root.wanted = index;
                PassphraseState.count-index = root.kept-count;
                root.ask(4);
            } else {
                root.kept-count = index;
                root.replace-words();
            }
        }
    }

    Rectangle {
        x: 24px;
        y: root.card-y;
        width: 432px;
        height: root.card-height;
        background: Look.card;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Look.edge;
        clip: true;

        // What to do, and, before the first word exists, what will happen to the words if the screen is left alone
        VerticalLayout {
            alignment: center;
            spacing: Theme.spacing-lg;
            padding-left: Theme.spacing-xl;
            padding-right: Theme.spacing-xl;

            Text {
                text: root.dice ? "Roll five dice for each word" : "Tap Generate to draw a passphrase";
                color: Theme.palette-muted.with-alpha(PassphraseState.words.length == 0 ? 1.0 : 0.0);
                animate color {
                    duration: 220ms;
                    easing: ease-in-out;
                }
                font-family: Theme.font-primary;
                font-size: Theme.font-size-body;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: "With no touch, the words are covered after " + Policy.hide-after + " s and wiped after " + Policy.wipe-after + " s.";
                color: Theme.palette-muted.with-alpha(PassphraseState.words.length == 0 ? 1.0 : 0.0);
                animate color {
                    duration: 220ms;
                    easing: ease-in-out;
                }
                font-family: Theme.font-primary;
                font-size: Theme.font-size-label;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // top-aligned, so a word that is already there never moves when the next one arrives
        VerticalLayout {
            padding-top: 18px;
            padding-bottom: 6px;
            alignment: start;
            spacing: 0px;

            for word[index] in PassphraseState.words: WordRow {
                number: index + 1;
                text: word.text;
                frames: word.frames;
                revealed: PassphraseState.revealed;
                leaving: root.leaving;
                row-height: root.dice ? 30px : 34px;
            }
        }
    }

    // entropy: a number that counts up, a gauge, and the "show words" switch
    Rectangle {
        x: 24px;
        y: root.card-y + root.card-height + 12px;
        width: 432px;
        height: 44px;

        HorizontalLayout {
            alignment: start;
            spacing: Theme.spacing-sm;

            Text {
                text: Math.round(root.shown-bits * 10) / 10;
                color: Look.teal.with-alpha(PassphraseState.bits > 0 ? 1.0 : 0.0);
                animate color {
                    duration: 220ms;
                    easing: ease-in-out;
                }
                font-family: Theme.font-primary;
                font-size: 34px;
                font-weight: Theme.font-weight-bold;
                vertical-alignment: center;
            }

            Text {
                text: "bits";
                color: Theme.palette-muted.with-alpha(PassphraseState.bits > 0 ? 1.0 : 0.0);
                animate color {
                    duration: 220ms;
                    easing: ease-in-out;
                }
                font-family: Theme.font-primary;
                font-size: Theme.font-size-subtitle;
                vertical-alignment: center;
            }
        }

        Switch {
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            label: "Show words";
            checked <=> PassphraseState.revealed;
            changed(on) => {
                root.touched();
                PassphraseState.reveal-changed(on);
            }
        }
    }

    Rectangle {
        x: 24px;
        y: root.card-y + root.card-height + 62px;
        width: 432px;
        height: 4px;
        border-radius: 2px;
        background: Look.edge;

        Rectangle {
            x: 0px;
            width: parent.width * Math.min(1.0, Math.max(0.0, root.shown-bits / 128.0));
            height: parent.height;
            border-radius: 2px;
            background: @linear-gradient(90deg, Look.teal 0%, Look.copper 100%);
        }
    }

    Text {
        x: 24px;
        y: root.card-y + root.card-height + 74px;
        width: 432px;
        height: 20px;
        text: PassphraseState.status;
        color: Theme.palette-muted;
        font-family: Theme.font-primary;
        font-size: Theme.font-size-label;
        horizontal-alignment: center;
    }

    // device RNG: one big button
    Button {
        x: 24px;
        y: 712px;
        width: 432px;
        height: 64px;
        opacity: !root.dice ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity {
            duration: 220ms;
            easing: ease-in-out;
        }
        text: PassphraseState.words.length == 0 ? "Generate" : "Generate new";
        size: ControlSize.lg;
        full-width: true;
        clicked => {
            root.touched();
            if PassphraseState.words.length > 0 {
                root.ask(1);
            } else {
                PassphraseState.generate();
            }
        }
    }

    // my dice: the five slots, the keys 1-6 and undo
    Rectangle {
        opacity: root.dice && !PassphraseState.finished ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity {
            duration: 220ms;
            easing: ease-in-out;
        }

        HorizontalLayout {
            x: 100px;
            y: 552px;
            width: 280px;
            height: 48px;
            spacing: 10px;

            for digit[index] in PassphraseState.slots: Slot {
                digit: digit;
            }
        }

        for pip in [1, 2, 3, 4, 5, 6]: Button {
            x: 24px + Math.mod(pip - 1, 3) * 147px;
            y: pip <= 3 ? 608px : 672px;
            width: 138px;
            height: 56px;
            text: pip;
            variant: ButtonVariant.secondary;
            size: ControlSize.md;
            full-width: true;
            clicked => {
                root.touched();
                PassphraseState.die(pip);
            }
        }

        Button {
            x: 24px;
            y: 736px;
            width: 432px;
            height: 40px;
            text: "Undo";
            variant: ButtonVariant.ghost;
            size: ControlSize.sm;
            full-width: true;
            clicked => {
                root.touched();
                PassphraseState.undo();
            }
        }
    }

    Button {
        x: 24px;
        y: 712px;
        width: 432px;
        height: 64px;
        opacity: root.dice && PassphraseState.finished ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity {
            duration: 220ms;
            easing: ease-in-out;
        }
        text: "Start over";
        size: ControlSize.lg;
        full-width: true;
        clicked => {
            root.ask(2);
        }
    }

    // What the passphrase's bits stand for: the figure is only as good as the dice, or the RNG, behind it.
    Text {
        x: 24px;
        y: root.card-y + root.card-height + 100px;
        width: 432px;
        height: 18px;
        text: root.dice ? "Assumes fair dice and independent rolls." : "Assumes the device RNG is unbiased.";
        color: Theme.palette-muted.with-alpha(PassphraseState.bits > 0 ? 1.0 : 0.0);
        animate color {
            duration: 220ms;
            easing: ease-in-out;
        }
        font-family: Theme.font-primary;
        font-size: Theme.font-size-label;
        horizontal-alignment: center;
    }

    // Drawn last, so it covers everything and takes every touch while it is open.
    Dialog {
        width: parent.width;
        height: parent.height;
        open: root.confirm != 0;
        variant: DialogVariant.danger;
        dismissable: true;
        dismissed => {
            root.touched();
            root.confirm = 0;
        }

        Text {
            text: root.confirm == 2 ? "Start over?" : "Replace this passphrase?";
            color: Theme.palette-foreground;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-title;
            font-weight: Theme.font-weight-bold;
            wrap: word-wrap;
        }

        Text {
            text: (root.confirm == 1 ? "A new one will be drawn, and the words on the screen wiped."
                : root.confirm == 2 ? "The words on the screen will be wiped."
                : root.confirm == 3 ? "Changing the mode wipes the words on the screen."
                : "Changing the number of words wipes the words on the screen.")
                + " They are saved nowhere, so they cannot be brought back.";
            color: Theme.palette-muted;
            font-family: Theme.font-primary;
            font-size: Theme.font-size-body;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: Theme.spacing-md;

            Button {
                text: "Keep";
                variant: ButtonVariant.secondary;
                size: ControlSize.md;
                full-width: true;
                clicked => {
                    root.touched();
                    root.confirm = 0;
                }
            }

            Button {
                text: root.confirm == 2 ? "Start over" : "Replace";
                variant: ButtonVariant.danger;
                size: ControlSize.md;
                full-width: true;
                clicked => {
                    root.confirmed();
                }
            }
        }
    }
}
